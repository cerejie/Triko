# Copy to .env.local (git-ignored) and fill in.

# --- Mobile app (bundled into the APK — public values ONLY) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Publishable key (sb_publishable_...). Never put a secret key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project-controlled domain for synthetic auth emails (drv001@<domain>).
# Must be a domain the project owns. Never shown to drivers.
EXPO_PUBLIC_AUTH_EMAIL_DOMAIN=auth.triko.app

# --- Edge Functions (set with `supabase secrets set`, never in the app) ---
# SUPABASE_* names are reserved by the CLI, hence TRIKO_*. Locally the runtime's
# injected SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are used as fallbacks.
# Local: put these in supabase/functions/.env (git-ignored) for `supabase functions serve`.
# TRIKO_SECRET_KEY=sb_secret_...
# TRIKO_PUBLISHABLE_KEY=sb_publishable_...
# AUTH_EMAIL_DOMAIN=auth.triko.app
